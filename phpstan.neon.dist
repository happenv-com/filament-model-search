includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/happenv-com/filament-phpstan-macros/extension.neon

parameters:
    level: 8
    paths:
        - src
        - config
    checkOctaneCompatibility: true
    ignoreErrors:
        # A public trait for host resources: the package itself never uses it.
        -
            identifier: trait.unused
            path: src/Concerns/InteractsWithModelSearch.php
