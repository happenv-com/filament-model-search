includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/happenv-com/filament-phpstan-macros/extension.neon

parameters:
    level: 8
    paths:
        - src
        - config
        - phpstan
    checkOctaneCompatibility: true
    bootstrapFiles:
        - phpstan/bootstrap.php
    stubFiles:
        - phpstan/macroable.stub
